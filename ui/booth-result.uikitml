<div id="BoothResultRoot" style="width: 120; background-color: #171226; border-color: #06d6a0; border-width: 1; border-radius: 4; padding-top: 7; padding-right: 9; padding-bottom: 7; padding-left: 9; display: flex; flex-direction: column; align-items: center; gap: 5;">
  <style>
    .title { font-size: 5.4; font-weight: 700; color: #06d6a0; text-align: center; }
    .score { font-size: 6.4; font-weight: 700; color: #ffffff; text-align: center; }
    .tickets { font-size: 4.4; font-weight: 700; color: #ffd166; text-align: center; }
    .stars { font-size: 6; color: #ffd166; text-align: center; }
    .btn { font-size: 4; font-weight: 700; color: #1a1428; background-color: #ffd166; border-radius: 3; padding-top: 3; padding-right: 10; padding-bottom: 3; padding-left: 10; cursor: pointer; text-align: center; }
    .btn-ghost { font-size: 3.6; font-weight: 700; color: #ffd166; background-color: #2a2140; border-color: #ffd166; border-width: 0.6; border-radius: 3; padding-top: 2.6; padding-right: 9; padding-bottom: 2.6; padding-left: 9; cursor: pointer; text-align: center; }
    .row { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 5; }
  </style>
  <div class="title">ROUND OVER</div>
  <div id="ResultScore" class="score">Score: 0</div>
  <div id="ResultTickets" class="tickets">+1 tickets</div>
  <div id="ResultStars" class="stars">☆☆☆</div>
  <div class="row">
    <button id="BtnAgain" class="btn">PLAY AGAIN</button>
    <button id="BtnPlaza" class="btn-ghost">PLAZA</button>
  </div>
</div>
