<div id="BoothHudRoot" style="width: 96; background-color: #171226; border-color: #06d6a0; border-width: 1; border-radius: 4; padding-top: 5; padding-right: 7; padding-bottom: 5; padding-left: 7; display: flex; flex-direction: column; align-items: center; gap: 2.5;">
  <style>
    .score { font-size: 5.4; font-weight: 700; color: #ffffff; text-align: center; }
    .info { font-size: 3.6; color: #ffd166; text-align: center; }
    .combo { font-size: 4; font-weight: 700; color: #ef476f; text-align: center; }
  </style>
  <div id="HudScore" class="score">SCORE 0</div>
  <div id="HudInfo" class="info">TIME 1:00</div>
  <div id="HudCombo" class="combo"></div>
</div>
